# Which providers SkinProof calls: "fixture" (offline, clearly labelled, spends
# nothing) or "live" (real YouCam API calls that spend units).
PROVIDER_MODE=fixture

# YouCam API key from https://yce.makeupar.com/api-console/en/api-keys/
# Server-side only. Never commit a real value.
YOUCAM_API_KEY=

# Optional override; the documented server is https://yce-api-01.makeupar.com
YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com

# Live spend guard: the most YouCam units this server may spend per UTC day,
# estimated from the documented unit table (skin analysis 14, try-on 1).
LIVE_DAILY_UNIT_BUDGET=100

# Where the SQLite database and image files are stored.
DATA_DIR=./data

# Photos, masks and try-on images are deleted this many hours after upload.
# Consultations themselves (scores, choices, decisions) are deleted after
# CONSULTATION_RETENTION_DAYS. Users can delete everything sooner themselves.
RETENTION_HOURS=24
CONSULTATION_RETENTION_DAYS=30

# Optional shared code required before anything that spends units on a hosted
# copy. Leave empty for local use. This is a demo gate, not user accounts.
APP_ACCESS_CODE=
